{
"k": "1e3c6547",
"t": "الزَّلَمِة بِيقُول: أَهْلا، تْفَضَّل!"
},
{
"k": "c3569eec",
"t": "يُوسي بِيقُول: بِدّي حُمُّص وْفَلافِل لَو سَمَحْت"
},
{
"k": "aa751ca2",
"t": "آه، مَيّ لَو سَمَحْت"
},
{
"k": "1678bd9d",
"t": "الحُمُّص زاكي، بَس شْوَيّ غالي"
},
{
"k": "e8d2c8e9",
"t": "يُوسي بِيقُول: شُكْرًا، يَعْطيك العافْيِة"
},
{
"k": "993fb22d",
"t": "دانا في مَدينِة جْديدِة"
},
{
"k": "d789e60e",
"t": "بِتِسْأَل زَلَمِة: مَرْحَبا، وِين السُّوق؟"
},
{
"k": "841e91d9",
"t": "الزَّلَمِة بِيقُول: السُّوق مِش بْعيد"
},
{
"k": "4f12425c",
"t": "رُوحي يَمين، بَعْدين شْمال"
},
{
"k": "5171ae2b",
"t": "دانا بِتْقُول: ما فْهِمِت. إِحْكي بِشْوَيْش لَو سَمَحْت"
},
{
"k": "05366d2c",
"t": "يَمين، بَعْدين، شْمال"
},
{
"k": "476ac915",
"t": "آه! هَسّا فْهِمِت. شُكْرًا كْتير!"
},
{
"k": "d758b9e3",
"t": "عَفْوًا، مَعَ السَّلامِة"
},
{
"k": "e9d1245c",
"t": "بُكْرَة في عُرُس عِنْد جيراني"
},
{
"k": "e34f9762",
"t": "جاري بِيقُول: تَعال، أَهْلا وْسَهْلا!"
},
{
"k": "1f7543b1",
"t": "أَنا بَقُول: عَلى راسي!"
},
{
"k": "62b1e73e",
"t": "في العُرُس في أَكِل كْتير وْموسيقى"
},
{
"k": "a70ee348",
"t": "كُلّ النّاس بِيقُولُوا: مَبْروك!"
},
{
"k": "81d8eaaa",
"t": "وِالعَريس بِيقُول: اللّه يْبارِك فيك"
},
{
"k": "bd0f6885",
"t": "بْنُرْقُص لَنُصّ اللِّيل"
},
{
"k": "b18174ba",
"t": "بَعْدين بَقُول: يَعْطيكُم العافْيِة، بْنِشُوفْكُم!"
},
{
"k": "627c4400",
"t": "أَنا بَشْتِغِل في مَطْعَم في حِيفا"
},
{
"k": "7fc7ad8e",
"t": "مَعي شَبّ مِن أُمّ الفَحِم، إِسْمُه سامِر"
},
{
"k": "a6fedd6a",
"t": "كُلّ يُوم الصُّبِح بَقُلُّه: صَباح الخِير، يَعْطيك العافْيِة"
},
{
"k": "c7b9fde1",
"t": "وْهُوِّ بِيقُول: صَباح النُّور، اللّه يْعافيك"
},
{
"k": "38461954",
"t": "إِحْنا بْنِحْكي عَرَبي وْعِبْري"
},
{
"k": "25c6fe5c",
"t": "يَعْني، شْوَيّ هِيك وْشْوَيّ هِيك"
},
{
"k": "51602953",
"t": "لَمّا ما بَفْهَم، بَقُول: كَمان مَرَّة لَو سَمَحْت"
},
{
"k": "dc9f40bf",
"t": "وْسامِر بِيقُول: ما فِي مُشْكِلِة يا زَلَمِة!"
